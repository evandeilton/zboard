# Data lives on the orphan `data` branch, checked out at runtime into this
# path by CI. Never tracked on `main`.
/data/

# Ephemeral inter-job handoff for the collect -> consolidate workflow jobs.
/staging/

# Quarto build output, published to the `gh-pages` branch by CI.
/_site/
/site/.quarto/

# JSON derived from Parquet at build time. Regenerated by
# R/export_json.R from `data/*.parquet` before every render.
/site/_data/

# renv
renv/library/
renv/staging/
renv/sandbox/
renv/python/

# R session/session artifacts
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# Local secrets (GITHUB_TOKEN, OPENALEX_MAILTO) for interactive dev.
# Never committed -- see README.md "Environment variables".
.Renviron

# R package build/check artifacts
/*.Rcheck/
/zboard_*.tar.gz
/doc/
/Meta/

.DS_Store

# pkgdown output, built and published by .github/workflows/pkgdown.yaml.
/docs/
